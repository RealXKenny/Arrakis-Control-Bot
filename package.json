{
  "name": "Arrakis-Control-Bot",
  "version": "1.0.6",
  "description": "A modular Sapphire Framework and Discord.js v14 bot.",
  "main": "src/index.ts",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "dev": "tsx src/client/shard.ts",
    "dev:watch": "tsx watch src/client/shard.ts",
    "start": "node dist/src/index.js",
    "start:single": "node dist/src/client/shard.js",
    "test": "npm run build && vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@sapphire/framework": "^5.5.1",
    "@sapphire/plugin-subcommands": "^7.0.1",
    "canvas": "^3.2.3",
    "concurrently": "^10.0.5",
    "discord.js": "^14.25.1",
    "dotenv": "^17.4.2",
    "pg": "^8.23.0"
  },
  "allowScripts": {
    "canvas@3.2.3": true,
    "esbuild@0.28.2": true
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^26.5.0",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
