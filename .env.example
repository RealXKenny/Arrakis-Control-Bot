# ============================================================================
# ARRAKIS CONTROL • ENVIRONMENT TEMPLATE
# Copy this file to .env and replace every placeholder before starting.
# Never commit your real .env file or any secret.
# ============================================================================

# ----------------------------------------------------------------------------
# DISCORD CONNECTION
# ----------------------------------------------------------------------------
TOKEN=replace_with_discord_bot_token
CLIENT_ID=replace_with_discord_application_id
# Shared server ID for single-guild features such as voice rooms and music.
GUILD_ID=replace_with_discord_server_id
TOTAL_SHARDS=auto

# ----------------------------------------------------------------------------
# DUNE CONSOLE CONNECTION
# ----------------------------------------------------------------------------
CONSOLE_URL=https://your-console-host
CONSOLE_API_KEY=replace_with_scoped_console_api_key
ADAPTER_TOKEN=replace_with_adapter_token

# ----------------------------------------------------------------------------
# OPTIONAL ADVINSERVERS / CONVOY CONNECTION
# ----------------------------------------------------------------------------
# Convoy panel origin; /servers uses /api/v1/client/servers.
# API_KEY needs server.read in the intended team and an allowed source IP.
API_URL=https://your-api-host
API_KEY=replace_with_api_key

# ----------------------------------------------------------------------------
# DISCORD PANEL CHANNELS
# ----------------------------------------------------------------------------
LINK_PANEL_CHANNEL_ID=replace_with_link_panel_channel_id
BLUEPRINT_PANEL_CHANNEL_ID=replace_with_blueprint_panel_channel_id
ROLE_PANEL_CHANNEL_ID=replace_with_role_panel_channel_id
VERIFY_CHANNEL_ID=replace_with_verify_channel_id
RULES_CHANNEL_ID=replace_with_rules_channel_id
SERVER_INFO_CHANNEL_ID=replace_with_server_info_channel_id
FAQ_PANEL_CHANNEL_ID=replace_with_faq_panel_channel_id
ANNOUNCEMENT_CHANNEL_ID=replace_with_announcement_channel_id
TICKET_PANEL_CHANNEL_ID=replace_with_ticket_panel_channel_id
TICKET_CATEGORY_ID=replace_with_ticket_category_id
TICKET_TRANSCRIPT_CHANNEL_ID=replace_with_ticket_transcript_channel_id
STORM_CHANNEL_ID=replace_with_storm_channel_id
WELCOME_CHANNEL_ID=replace_with_welcome_channel_id
GOODBYE_CHANNEL_ID=replace_with_goodbye_channel_id

# ----------------------------------------------------------------------------
# POSTGRESQL TICKET, VOICE-ROOM, MUSIC AND LEVEL STORAGE
# ----------------------------------------------------------------------------
DATABASE_URL=postgresql://arrakis:replace_with_database_password@postgres:5432/arrakis_control
# Set true when your PostgreSQL provider requires TLS.
DATABASE_SSL=false
# Leveling starts automatically when DATABASE_URL is configured. Uncomment to disable it.
# LEVELING_ENABLED=false

# ----------------------------------------------------------------------------
# LOGGING CHANNELS
# ----------------------------------------------------------------------------
AUDIT_CHANNEL_ID=replace_with_audit_channel_id
ACTIVITY_LOG_CHANNEL_ID=replace_with_activity_log_channel_id

# ----------------------------------------------------------------------------
# DISCORD ROLE IDs
# ----------------------------------------------------------------------------
LINKED_PLAYER_ROLE_ID=replace_with_linked_player_role_id
VERIFIED_MEMBER_ROLE_ID=replace_with_verified_member_role_id
TRIAL_STAFF_ROLE_ID=replace_with_trial_staff_role_id
MODERATOR_ROLE_ID=replace_with_moderator_role_id
SENIOR_MODERATOR_ROLE_ID=replace_with_senior_moderator_role_id
ADMINISTRATOR_ROLE_ID=replace_with_administrator_role_id
HEAD_ADMINISTRATOR_ROLE_ID=replace_with_head_administrator_role_id
OWNER_ROLE_ID=replace_with_owner_role_id

# ----------------------------------------------------------------------------
# COMMUNITY LEVEL ROLE IDs
# ----------------------------------------------------------------------------
LEVEL_ROLE_ARRAKIS_WANDERER_ID=replace_with_arrakis_wanderer_role_id
LEVEL_ROLE_SIETCH_DWELLER_ID=replace_with_sietch_dweller_role_id
LEVEL_ROLE_DESERT_SURVIVOR_ID=replace_with_desert_survivor_role_id
LEVEL_ROLE_SAND_WARRIOR_ID=replace_with_sand_warrior_role_id
LEVEL_ROLE_SPICE_HUNTER_ID=replace_with_spice_hunter_role_id
LEVEL_ROLE_FREMEN_INITIATE_ID=replace_with_fremen_initiate_role_id
LEVEL_ROLE_DESERT_MASTER_ID=replace_with_desert_master_role_id
LEVEL_ROLE_CHOSEN_OF_ARRAKIS_ID=replace_with_chosen_of_arrakis_role_id

# ----------------------------------------------------------------------------
# SELF-ASSIGNABLE ROLE IDs
# ----------------------------------------------------------------------------
ROLE_PVP_ID=replace_with_pvp_role_id
ROLE_PVE_ID=replace_with_pve_role_id
ROLE_BUILDER_ID=replace_with_builder_role_id
ROLE_CRAFTER_ID=replace_with_crafter_role_id
ROLE_TRADER_ID=replace_with_trader_role_id
ROLE_EXPLORER_ID=replace_with_explorer_role_id
ROLE_ENDGAME_ID=replace_with_endgame_role_id
ROLE_ATREIDES_ID=replace_with_atreides_role_id
ROLE_HARKONNEN_ID=replace_with_harkonnen_role_id
ROLE_FREMEN_ID=replace_with_fremen_role_id
ROLE_NEUTRAL_ID=replace_with_neutral_role_id
ROLE_ANNOUNCEMENTS_ID=replace_with_announcements_role_id
ROLE_EVENTS_ID=replace_with_events_role_id
ROLE_PVP_ALERTS_ID=replace_with_pvp_alerts_role_id
ROLE_MARKET_ALERTS_ID=replace_with_market_alerts_role_id
ROLE_LFG_ALERTS_ID=replace_with_lfg_alerts_role_id

# ----------------------------------------------------------------------------
# BOT DISPLAY, LOGGING, AND RELEASE ANNOUNCEMENTS
# ----------------------------------------------------------------------------
SERVER_NAME=Arrakis Community Server
LOG_LEVEL=INFO
VERSION_ANNOUNCEMENT_INTERVAL_MINUTES=5
INTERACTION_COOLDOWN_MS=2000
RATE_LIMIT_MAX_ENTRIES=10000

# Optional Discord <-> game map chat. Leave RABBITMQ_URL unset to disable.
# Use the REMOTE broker DNS/IP and its AMQP(S) port, not its management HTTP port.
# URL-encode the password. Username must match the registered persona's hex ID.
# RABBITMQ_URL=amqps://5E121CE000000001:URL_ENCODED_PASSWORD@rabbit.example.com:31982/%2F
# CHAT_BRIDGE_FUNCOM_ID="ServerAdmin#0001"
# Optional explicit sender name to bypass native player-name lookup.
# May display as a HUD notification only; verify against your game version.
# CHAT_BRIDGE_DISPLAY_NAME="Arrakis Control"
# Repeat a channel with different maps for shared chat; use different channels to separate them.
# CHAT_BRIDGE_ROUTES='[{"guildId":"123456789012345678","channelId":"234567890123456789","map":"HaggaBasin.0"},{"guildId":"123456789012345678","channelId":"234567890123456789","map":"Survival_1.dim_1"},{"guildId":"123456789012345678","channelId":"234567890123456789","map":"DeepDesert_1.0"},{"guildId":"123456789012345678","channelId":"234567890123456789","map":"DeepDesert_1.dim_1"},{"guildId":"123456789012345678","channelId":"234567890123456789","map":"SH_Arrakeen.0"},{"guildId":"123456789012345678","channelId":"234567890123456789","map":"SH_HarkoVillage.0"},{"guildId":"123456789012345678","channelId":"234567890123456789","map":"Survival_1.dim_0"}]'
# Optional PEM CA certificate on the BOT machine for a private certificate authority.
# RABBITMQ_CA_FILE=C:/certificates/rabbitmq-ca.pem
# Optional expected certificate DNS name when connecting through a different host/IP.
# RABBITMQ_TLS_SERVERNAME=dune-rmq-game

# Join-to-create voice rooms. Uses the shared GUILD_ID above.
# Set all three IDs to configure automatically, or leave them blank to use /voice setup.
VOICE_JOIN_CHANNEL_ID=
VOICE_CATEGORY_ID=
VOICE_PANEL_CHANNEL_ID=
# Make the configured panel readable by everyone; owner checks still apply.
# The bot needs Manage Roles in the panel channel to update its overwrites.
VOICE_PANEL_PUBLIC=true

# ----------------------------------------------------------------------------
# OPTIONAL LAVALINK MUSIC LOUNGE
# ----------------------------------------------------------------------------
# Leave LAVALINK_URL blank to disable music. No Lavalink password goes in Git.
# Music requires DATABASE_URL; the queue, requester ownership, volume and playback position persist there.
# Remote example: https://lavalink.example.com (HTTP example: http://localhost:2333)
LAVALINK_URL=
LAVALINK_PASSWORD=
# Permanent voice channel; must NOT be a Join to Create channel or temporary room.
MUSIC_VOICE_CHANNEL_ID=
# Dedicated text channel for song requests and the automatic public music control panel.
MUSIC_REQUEST_CHANNEL_ID=
# spsearch uses the recommended LavaSrc template in guides/lavalink/. Use scsearch without Spotify credentials.
# Also supported when their Lavalink sources are configured: amsearch, dzsearch, ytsearch, ytmsearch.
MUSIC_SEARCH_SOURCE=spsearch
# Unity gain preserves the source level; listeners can adjust Discord's per-user volume locally.
MUSIC_VOLUME=100
# Includes the current track. Playlists must fit in the remaining space.
MUSIC_MAX_QUEUE=100
