# ╭────────────────────────────────────────────────────────────────╮
# │ ARRAKIS CONTROL                                                │
# │ Dune: Awakening Bot                                            │
# ╰────────────────────────────────────────────────────────────────╯

# ╭────────────────────────────────────────────────────────────────╮
# │ 01  •  DISCORD CONNECTION                                      │
# ╰────────────────────────────────────────────────────────────────╯

TOKEN=replace_with_discord_bot_token
CLIENT_ID=replace_with_discord_application_id
GUILD_ID=replace_with_discord_server_id
# Servers the bot may stay in (comma-separated). Defaults to GUILD_ID; the bot leaves any other server.
ALLOWED_GUILD_IDS=
# One shard serves a single server. Use auto or a higher number only if the bot joins about 2,000+ servers.
TOTAL_SHARDS=1

# ╭────────────────────────────────────────────────────────────────╮
# │ 02  •  DUNE CONSOLE                                            │
# ╰────────────────────────────────────────────────────────────────╯

CONSOLE_URL=https://your-console-host
CONSOLE_API_KEY=replace_with_scoped_console_api_key
# Per-attempt Console request timeout in milliseconds (1000-120000). Reads retry twice with jitter; writes never retry.
CONSOLE_TIMEOUT_MS=30000
ADAPTER_TOKEN=replace_with_adapter_token

# ╭────────────────────────────────────────────────────────────────╮
# │ 03  •  CONVOY                                                  │
# ╰────────────────────────────────────────────────────────────────╯

API_URL=https://your-api-host
API_KEY=replace_with_api_key

# ╭────────────────────────────────────────────────────────────────╮
# │ 04  •  DISCORD CHANNELS AND PANELS                             │
# ╰────────────────────────────────────────────────────────────────╯

# Persistent panels and release announcements require DATABASE_URL.
# Existing bot messages are imported once; later updates use stored message IDs.
LINK_PANEL_CHANNEL_ID=replace_with_link_panel_channel_id
BLUEPRINT_PANEL_CHANNEL_ID=replace_with_blueprint_panel_channel_id
ROLE_PANEL_CHANNEL_ID=replace_with_role_panel_channel_id
VERIFY_CHANNEL_ID=replace_with_verify_channel_id
RULES_CHANNEL_ID=replace_with_rules_channel_id
SERVER_INFO_CHANNEL_ID=replace_with_server_info_channel_id
FAQ_PANEL_CHANNEL_ID=replace_with_faq_panel_channel_id
# Changelog channel. A forum channel gets one post per release with product and release-type tags; a text or
# announcement channel gets one short post per release with the full notes in its thread.
ANNOUNCEMENT_CHANNEL_ID=replace_with_announcement_channel_id
TICKET_PANEL_CHANNEL_ID=replace_with_ticket_panel_channel_id
BOT_CONTROL_CHANNEL_ID=replace_with_private_bot_control_channel_id
TICKET_CATEGORY_ID=replace_with_ticket_category_id
TICKET_TRANSCRIPT_CHANNEL_ID=replace_with_ticket_transcript_channel_id
STORM_CHANNEL_ID=replace_with_storm_channel_id
WELCOME_CHANNEL_ID=replace_with_welcome_channel_id
GOODBYE_CHANNEL_ID=replace_with_goodbye_channel_id

# ╭────────────────────────────────────────────────────────────────╮
# │ 05  •  POSTGRESQL STORAGE                                      │
# ╰────────────────────────────────────────────────────────────────╯

DATABASE_URL=postgresql://arrakis:replace_with_database_password@postgres:5432/arrakis_control
DATABASE_SSL=false
# Certificates are verified when DATABASE_SSL=true. Set false only for a trusted self-signed server.
DATABASE_SSL_VERIFY=true
# Interactive and background (message archive, XP) connection pools, and a per-query time limit.
DATABASE_POOL_MAX=10
DATABASE_BACKGROUND_POOL_MAX=5
DATABASE_STATEMENT_TIMEOUT_MS=15000
# Days to keep archived messages and edit history. 0 keeps them forever. Deletion cannot be undone.
MESSAGE_ARCHIVE_RETENTION_DAYS=0
# Log a runtime health summary (event loop, memory, database pools, gateway) every N seconds. 0 turns it off.
RUNTIME_METRICS_INTERVAL_SECONDS=60
# Optional file the bot rewrites with its latest health snapshot, for container health checks.
HEALTH_FILE=
LEVELING_ENABLED=

# ╭────────────────────────────────────────────────────────────────╮
# │ 06  •  LOGGING CHANNELS                                        │
# ╰────────────────────────────────────────────────────────────────╯

AUDIT_CHANNEL_ID=replace_with_audit_channel_id
ACTIVITY_LOG_CHANNEL_ID=replace_with_activity_log_channel_id

# ╭────────────────────────────────────────────────────────────────╮
# │ 07  •  DISCORD ACCESS ROLES                                    │
# ╰────────────────────────────────────────────────────────────────╯

LINKED_PLAYER_ROLE_ID=replace_with_linked_player_role_id
VERIFIED_MEMBER_ROLE_ID=replace_with_verified_member_role_id
TRIAL_STAFF_ROLE_ID=replace_with_trial_staff_role_id
MODERATOR_ROLE_ID=replace_with_moderator_role_id
SENIOR_MODERATOR_ROLE_ID=replace_with_senior_moderator_role_id
ADMINISTRATOR_ROLE_ID=replace_with_administrator_role_id
HEAD_ADMINISTRATOR_ROLE_ID=replace_with_head_administrator_role_id
OWNER_ROLE_ID=replace_with_owner_role_id

# ╭────────────────────────────────────────────────────────────────╮
# │ 08  •  STAFF APPLICATIONS                                      │
# ╰────────────────────────────────────────────────────────────────╯

STAFF_APPLICATION_PANEL_CHANNEL_ID=replace_with_staff_application_panel_channel_id
STAFF_APPLICATION_REVIEW_CHANNEL_ID=replace_with_private_staff_review_channel_id
STAFF_APPLICATION_REVIEWER_ROLE_ID=replace_with_staff_reviewer_role_id
STAFF_APPLICATION_PENDING_ROLE_ID=replace_with_application_pending_role_id
STAFF_APPLICATION_ACCEPTED_ROLE_ID=replace_with_staff_accepted_role_id
STAFF_APPLICATION_COOLDOWN_DAYS=7

# ╭────────────────────────────────────────────────────────────────╮
# │ 09  •  COMMUNITY LEVELING                                      │
# ╰────────────────────────────────────────────────────────────────╯

LEVEL_ANNOUNCEMENT_CHANNEL_ID=replace_with_level_announcement_channel_id
LEVEL_ROLE_ARRAKIS_WANDERER_ID=replace_with_arrakis_wanderer_role_id
LEVEL_ROLE_SIETCH_DWELLER_ID=replace_with_sietch_dweller_role_id
LEVEL_ROLE_DESERT_SURVIVOR_ID=replace_with_desert_survivor_role_id
LEVEL_ROLE_SAND_WARRIOR_ID=replace_with_sand_warrior_role_id
LEVEL_ROLE_SPICE_HUNTER_ID=replace_with_spice_hunter_role_id
LEVEL_ROLE_FREMEN_INITIATE_ID=replace_with_fremen_initiate_role_id
LEVEL_ROLE_DESERT_MASTER_ID=replace_with_desert_master_role_id
LEVEL_ROLE_CHOSEN_OF_ARRAKIS_ID=replace_with_chosen_of_arrakis_role_id

# ╭────────────────────────────────────────────────────────────────╮
# │ 10  •  SELF-ASSIGNABLE ROLES                                   │
# ╰────────────────────────────────────────────────────────────────╯

ROLE_PVP_ID=replace_with_pvp_role_id
ROLE_PVE_ID=replace_with_pve_role_id
ROLE_BUILDER_ID=replace_with_builder_role_id
ROLE_CRAFTER_ID=replace_with_crafter_role_id
ROLE_TRADER_ID=replace_with_trader_role_id
ROLE_EXPLORER_ID=replace_with_explorer_role_id
ROLE_ENDGAME_ID=replace_with_endgame_role_id
ROLE_ATREIDES_ID=replace_with_atreides_role_id
ROLE_HARKONNEN_ID=replace_with_harkonnen_role_id
ROLE_FREMEN_ID=replace_with_fremen_role_id
ROLE_NEUTRAL_ID=replace_with_neutral_role_id
ROLE_ANNOUNCEMENTS_ID=replace_with_announcements_role_id
ROLE_EVENTS_ID=replace_with_events_role_id
ROLE_PVP_ALERTS_ID=replace_with_pvp_alerts_role_id
ROLE_MARKET_ALERTS_ID=replace_with_market_alerts_role_id
ROLE_LFG_ALERTS_ID=replace_with_lfg_alerts_role_id

# ╭────────────────────────────────────────────────────────────────╮
# │ 11  •  BOT RUNTIME                                             │
# ╰────────────────────────────────────────────────────────────────╯

SERVER_NAME=Arrakis Community Server
LOG_LEVEL=INFO
# Console colours: auto (terminal or Pterodactyl), always or never. NO_COLOR also turns them off.
LOG_COLOR=auto
# HTTPS origin of the dashboard; required for release announcements.
DASHBOARD_URL=
VERSION_ANNOUNCEMENT_INTERVAL_MINUTES=5
INTERACTION_COOLDOWN_MS=2000
RATE_LIMIT_MAX_ENTRIES=10000

# ╭────────────────────────────────────────────────────────────────╮
# │ 12  •  DISCORD AND DUNE CHAT BRIDGE                            │
# ╰────────────────────────────────────────────────────────────────╯

RABBITMQ_URL=
CHAT_BRIDGE_FUNCOM_ID=
CHAT_BRIDGE_DISPLAY_NAME=
CHAT_BRIDGE_ROUTES=
# Proximity (nearby) chat to Discord, receive-only. Off by default. See guides/rabbitmq-discord.md.
CHAT_BRIDGE_PROXIMITY=
CHAT_BRIDGE_PROXIMITY_ROUTES=
CHAT_BRIDGE_PROXIMITY_INTERCEPT=
RABBITMQ_CA_FILE=
RABBITMQ_TLS_SERVERNAME=

# ╭────────────────────────────────────────────────────────────────╮
# │ 13  •  JOIN-TO-CREATE VOICE ROOMS                              │
# ╰────────────────────────────────────────────────────────────────╯

VOICE_GUILD_ID=
VOICE_JOIN_CHANNEL_ID=
VOICE_CATEGORY_ID=
VOICE_PANEL_CHANNEL_ID=
VOICE_PANEL_PUBLIC=true

# ╭────────────────────────────────────────────────────────────────╮
# │ 14  •  LAVALINK MUSIC LOUNGE                                   │
# ╰────────────────────────────────────────────────────────────────╯

MUSIC_GUILD_ID=
LAVALINK_URL=
LAVALINK_PASSWORD=
MUSIC_VOICE_CHANNEL_ID=
MUSIC_REQUEST_CHANNEL_ID=
MUSIC_IDLE_PLAYLIST_URL=https://open.spotify.com/album/1LwWQxFI1bS42McjRrQlRw
MUSIC_SEARCH_SOURCE=spsearch
MUSIC_VOLUME=100
MUSIC_MAX_QUEUE=100

# Honeypot: leave both channel IDs empty to disable. See guides/honeypot.md.
HONEYPOT_CHANNEL_ID=
HONEYPOT_LOG_CHANNEL_ID=
HONEYPOT_ACTION=ban
HONEYPOT_TIMEOUT_MINUTES=1440

# ╭────────────────────────────────────────────────────────────────╮
# │ 15  •  AUTOMATIC UPDATES (PTERODACTYL / SUPERVISOR)            │
# ╰────────────────────────────────────────────────────────────────╯

# Read by scripts/updater/supervisor.mjs, not by the bot. See guides/automatic-updates.md.
# Updates never overwrite .env, certificates or any file you changed; a conflicting update is skipped and logged.
# The panel's RELEASE_TAG pins a version (for example v2.1.0); latest follows the channel. Never downgrades.
AUTO_UPDATE_ENABLED=true
AUTO_UPDATE_ON_STARTUP=true
# stable or prerelease
AUTO_UPDATE_CHANNEL=stable
AUTO_UPDATE_INTERVAL_HOURS=6
# Optional UTC window for background installs, for example 03:00-05:00. Empty allows any time.
AUTO_UPDATE_WINDOW_UTC=
# Seconds a new version must stay up after its first "Discord shard" line before it is kept.
AUTO_UPDATE_HEALTH_SECONDS=120
# Optional read-only GitHub token for release downloads. Never needs write access.
AUTO_UPDATE_GITHUB_TOKEN=
# Install new releases right after they are published: the dashboard's release signal, for example
# https://dashboard.example.com/api/v2/updates/signal. Empty keeps the scheduled checks only.
AUTO_UPDATE_SIGNAL_URL=
# Seconds between release-signal checks (10-3600).
AUTO_UPDATE_SIGNAL_SECONDS=30

# ╭────────────────────────────────────────────────────────────────╮
# │ 16  •  SUGGESTION FORUM ASSISTANT                              │
# ╰────────────────────────────────────────────────────────────────╯

# Forum channel to manage. Leave empty to turn the assistant off. Requires DATABASE_URL. See guides/suggestions.md.
SUGGESTIONS_FORUM_CHANNEL_ID=
# Add category and Under Review tags to new posts that have none.
SUGGESTIONS_AUTO_TAG=true
# Post the assistant reply with staff status buttons under each new post.
SUGGESTIONS_STATUS_PANEL=true
# Mention the suggester when staff change the status.
SUGGESTIONS_NOTIFY_AUTHOR=true
# Create missing status tags (Planned, In Progress, Back Burner, Not Doing, Implemented) at startup.
SUGGESTIONS_CREATE_TAGS=true
# How alike two posts must be (0.1 to 0.95) to be listed as possibly related.
SUGGESTIONS_DUPLICATE_THRESHOLD=0.35
# Post a discussion summary every N replies. 0 turns automatic summaries off.
SUGGESTIONS_AUTO_SUMMARY_MESSAGES=50
# Most older posts read into the similarity index at startup (0 to 5000).
SUGGESTIONS_BACKFILL_LIMIT=500
# Once at startup, add tags and the assistant panel to older posts that have none. Nobody is pinged.
SUGGESTIONS_CATCHUP=true
# Follow the GitHub repositories and move statuses by itself: open issue = Planned, pull request or commit = In Progress, release = Implemented.
SUGGESTIONS_AUTOPILOT=true
# Comma-separated owner/name repositories the autopilot reads (read-only).
SUGGESTIONS_GITHUB_REPOS=RealXKenny/Arrakis-Control-Bot,RealXKenny/Arrakis-Control-Dashboard
# Optional read-only GitHub token (raises the limit from 60 to 5000 requests an hour). Never needs write access.
SUGGESTIONS_GITHUB_TOKEN=
# Minutes between GitHub checks (5 to 1440).
SUGGESTIONS_GITHUB_INTERVAL_MINUTES=15
# How alike GitHub work and a suggestion must be (0.1 to 0.95) before the autopilot moves it.
SUGGESTIONS_AUTOPILOT_THRESHOLD=0.3

# ╭────────────────────────────────────────────────────────────────╮
# │ 17  •  CHATBOT                                                 │
# ╰────────────────────────────────────────────────────────────────╯

# Homemade chatbot: mention the bot, reply to its answers, or use /chat ask. It learns from chat and answers questions by itself.
# Runs inside the bot with no outside AI. Learning, taught answers and its mood need DATABASE_URL. See guides/chatbot.md.
CHATBOT_ENABLED=true
# Who can talk to it by mention or /chat ask: everyone, staff (owner, Manage Server, staff roles) or roles (staff plus CHATBOT_ROLE_IDS).
CHATBOT_ACCESS=everyone
# Comma-separated role IDs allowed when CHATBOT_ACCESS=roles.
CHATBOT_ROLE_IDS=
# Comma-separated channel IDs where mentions are answered. Empty means every channel the bot can read. /chat ask works anywhere.
CHATBOT_CHANNEL_IDS=
# Seconds each member waits between answers (0 to 600).
CHATBOT_COOLDOWN_SECONDS=3
# Learn questions and the answers members give them. Only public channels (that @everyone can see) unless CHATBOT_LEARN_CHANNEL_IDS is set.
CHATBOT_LEARN=true
CHATBOT_LEARN_CHANNEL_IDS=
# Most learned answers kept (100 to 50000); the least used and oldest go first.
CHATBOT_LEARN_LIMIT=5000
# Answer questions in chat by itself, without a mention, when it is confident. Public channels unless CHATBOT_AUTO_CHANNEL_IDS is set.
CHATBOT_AUTO_REPLY=true
CHATBOT_AUTO_CHANNEL_IDS=
# How sure it must be (0.2 to 1) before answering unasked. Higher means quieter.
CHATBOT_AUTO_CONFIDENCE=0.5
# Seconds it waits so a member can answer first (0 to 300). Anyone else replying cancels its answer.
CHATBOT_AUTO_DELAY_SECONDS=15
# Seconds between two unasked answers in the same channel (0 to 3600).
CHATBOT_AUTO_COOLDOWN_SECONDS=60
# Look things up online when it doesn't know: the game wiki first, then DuckDuckGo instant answers, then Wikipedia.
# Free, no API key, read-only. It only sends a search phrase to these fixed sites and never opens links members post.
CHATBOT_WEB=true
# MediaWiki site searched first (https only), or none to skip it.
CHATBOT_WEB_WIKI_URL=https://dune.fandom.com
# Most web lookups per minute for the whole bot (1 to 120).
CHATBOT_WEB_PER_MINUTE=20
# Also look things up online for unasked answers. Off by default so it only searches when someone talks to it.
CHATBOT_WEB_AUTO=false
# The chatbot's own AI model, run inside the bot on the CPU (llama.cpp). No outside AI service and no API key.
# Off by default. When on, the bot downloads the model once from Hugging Face (checked against its SHA-256) and
# falls back to its rule-based answers if the model can't load or is too slow.
CHATBOT_AI=false
# small (Llama 3.2 3B, about 2 GB: give the server 8 GB of memory) or large (Qwen 2.5 7B, about 4.7 GB: give it 12 GB),
# or a Hugging Face GGUF model such as hf:owner/repo/model-Q4_K_M.gguf or hf:owner/repo:Q4_K_M.
# A wrong AI setting only turns the AI model off (with a warning); it never stops the bot.
CHATBOT_AI_MODEL=small
# SHA-256 a custom model download must match. The small and large presets already have theirs.
CHATBOT_AI_MODEL_SHA256=
# Folder the model file is kept in (relative to the bot's folder).
CHATBOT_AI_MODEL_DIR=models
# CPU threads the model may use (1 to 64). More is faster, but leaves less for the rest of the bot.
CHATBOT_AI_THREADS=8
# Tokens of conversation the model sees at once (1024 to 32768), and the longest answer (32 to 1024).
CHATBOT_AI_CONTEXT=4096
CHATBOT_AI_MAX_TOKENS=220
# Seconds before a slow answer is dropped for the rule-based one (5 to 600).
CHATBOT_AI_TIMEOUT_SECONDS=60
