# ╭────────────────────────────────────────────────────────────────╮
# │ 11  •  BOT RUNTIME                                             │
# ╰────────────────────────────────────────────────────────────────╯

SERVER_NAME=Arrakis Community Server
LOG_LEVEL=INFO
VERSION_ANNOUNCEMENT_INTERVAL_MINUTES=5
INTERACTION_COOLDOWN_MS=2000
RATE_LIMIT_MAX_ENTRIES=10000

# ╭────────────────────────────────────────────────────────────────╮
# │ 12  •  DISCORD AND DUNE CHAT BRIDGE                            │
# ╰────────────────────────────────────────────────────────────────╯

RABBITMQ_URL=
CHAT_BRIDGE_FUNCOM_ID=
CHAT_BRIDGE_DISPLAY_NAME=
CHAT_BRIDGE_ROUTES=
