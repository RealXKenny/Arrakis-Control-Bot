# These settings belong to the Lavalink process/container, not the bot's .env.
LAVALINK_PORT=25004
LAVALINK_PASSWORD=replace-with-a-long-random-password
SPOTIFY_CLIENT_ID=replace-with-your-spotify-app-client-id
SPOTIFY_CLIENT_SECRET=replace-with-your-spotify-app-client-secret
SPOTIFY_COUNTRY_CODE=US
